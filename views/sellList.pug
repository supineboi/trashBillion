extends layouts/base

block title 
    title TRASHBILLION — Trash Makes You Rich

block stylesheet
    link(rel="stylesheet" href="/css/sellList.css")

block content
    main.container

        // Page Heading
        section.top-section

            div
                .eyebrow ✳ THE GARBAGE MARKETPLACE

                h1
                    | ONE MAN'S TRASH.
                    br
                    span ANOTHER MAN'S GOLD.

                p.subtitle
                    | Explore the finest collection of unwanted treasures.
                    | Your next business empire might be hiding in here.

            // Statistics
            .stats

                .stat
                    strong #{items.length}
                    span Total listings

                .stat
                    strong ∞
                    span Profit potential


        // Search and Filters
        section.filters

            .search
                input(type="search" placeholder="Search garbage, ID or location...")

            select
                option(value="") All categories
                option(value="plastic") Plastic
                option(value="paper") Paper
                option(value="cardboard") Cardboard
                option(value="metal") Metal
                option(value="glass") Glass
                option(value="electronic") Electronic Waste


        // Listings Heading
        .results-heading
            h2 Latest Garbage Listings
            span Showing 6 listings


        // Listings Grid
        section.grid
            each item in items
                article.listing-card
                    .card-top
                        .category-icon #{item.icon}
                        span.status Available

                    .card-body
                        .listing-id ##{item.id}

                        h3 #{item.title}

                        p.description
                            | #{item.description}

                        .details
                            div
                                .detail-label CATEGORY
                                .detail-value #{item.category}

                            div
                                .detail-label QUANTITY
                                .detail-value #{item.quantity}

                        .info 
                            .location 
                                | 🇮🇳
                                span  #{item.location}
                            .phone
                                | 📞 
                                span +91 #{item.phone}
    // Footer
    footer
        p © 2026 TRASHBILLION. All trash reserved.

        p
            | Made with 
            span ♻ questionable business ideas.
