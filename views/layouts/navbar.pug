        | TRASH
        span BILLION.

    .nav-tag THE WORLD'S MOST QUESTIONABLE MARKET

    .nav-links
        a.nav-link(href="/trash") MARKET
        a.nav-link(href="/user/my-trash") MY TRASH
        a.nav-link(href="/portfolio") PORTFOLIO
        a.nav-link(href="/user/orders") ORDERS
        a.nav-link(href="/user/profile") PROFILE

    .btn-group
        +btn("/trash/sell", "BECOME A CEO")
