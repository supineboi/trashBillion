mixin btn(href, text)
    a.btn(href=href) #{text} ↗

nav
    a.logo(href="/")
        | TRASH
        span BILLION.
    .nav-tag The future of waste is wealth.

    if !["/user/login", "/user/signup"].includes(path)
        if path === '/trash/sell'
            +btn("/trash", "FIND TREASURE")

        else
            .btn-group
                +btn("/trash/sell", "GET RICH")

                if !isLoggedIn
                    +btn("/user/login", "JOIN THE EMPIRE")
                
