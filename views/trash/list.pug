
extends ../layouts/base

block title
    title TRASHBILLION — The Garbage Exchange

block stylesheet
    link(rel="stylesheet" href="/css/trash/list.css")

block content
    -
        const listings = items;

    main.container
        section.top-section
            div
                .eyebrow ✳ THE WORLD'S MOST QUESTIONABLE EXCHANGE

                h1
                    | THE MARKET IS
                    br
                    span TRASHING IT.

                p.subtitle
                    | Discover extraordinary assets nobody asked for.
                    | Because apparently, even garbage deserves a valuation.

            .stats
                .stat
                    strong 06
                    span Available assets

                .stat
                    strong ₹99Cr+
                    span Imaginary market cap

        section.market-banner
            .market-banner-copy
                span LIVE MARKET REPORT
                h2 The garbage economy is booming.
                p Your financial advisor has no idea what's happening.

            .market-index
                span TBX MARKET INDEX
                strong +420.69%
                small ▲ COMPLETELY UNREGULATED

        section.filters
            .search
                input(type="search" placeholder="Search assets, categories or locations...")

            select
                option(value="") All categories
                option(value="plastic") Plastic
                option(value="paper") Paper
                option(value="cardboard") Cardboard
                option(value="metal") Metal
                option(value="glass") Glass
                option(value="electronic") Electronic waste

            select
                option(value="") Sort by
                option(value="newest") Newest
                option(value="price") Highest valuation
                option(value="growth") Highest growth

        .results-heading
            div
                .eyebrow THE ASSET EXCHANGE
                h2 Latest investment opportunities

            span 06 ASSETS FOUND

        section.grid
            each item in listings
                a.listing-card(href=`/trash/${item.id}`)
                    .card-top
                        .category-icon #{item.icon}

                        span.status #{item.status}

                        span.asset-growth +#{item.growth}%

                    .card-body
                        .listing-id ##{item.id}

                        h3 #{item.title}

                        p.description #{item.description}

                        .details
                            div
                                .detail-label CATEGORY
                                .detail-value #{item.category}

                            div
                                .detail-label QUANTITY
                                .detail-value #{item.quantity} #{item.unit}

                        .info
                            .location
                                span 📍
                                span #{item.location}

                        .valuation
                            div
                                .detail-label CURRENT IMAGINARY VALUATION
                                .valuation-price #{item.valuation}

                        .card-action
                            span ANALYSE THIS ASSET
                            span.arrow ↗

        section.market-disclaimer
            span ✳
            p
                strong A SMALL REALITY CHECK:
                |  These are fictional listings with fictional valuations.
                | The garbage problem outside your window, unfortunately, isn't.

    footer
        p © 2026 TRASHBILLION. All trash reserved.
        p The joke is fictional. The litter isn't.
