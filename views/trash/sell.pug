extends ../layouts/base

block title
    title TRASHBILLION — The Garbage Exchange

block stylesheet
    link(rel="stylesheet" href="/css/trash/sell.css")

block content
  .sell-page
    .sell-container

      .sell-header
        .sell-eyebrow SELL YOUR ASSETS
        h1 Turn your trash into a <span>fortune.</span>
        p
          | Every great empire starts somewhere.
          | Yours starts with something someone threw away.

      .sell-layout
        .sell-main
          form.sell-form(action="/trash/sell" method="POST")

            .sell-section
              .section-heading
                span.section-number 01
                div
                  h2 Asset information
                  p Tell the world what you're offering.
              .sell-grid
                .sell-field
                  label(for="title") Listing title
                  input#title(
                    type="text"
                    name="title"
                    placeholder="e.g. Premium roadside plastic collection"
                    maxlength="150"
                    required
                  )

                .sell-field
                  label(for="categoryId") Category
                  select#categoryId(name="categoryId" required)
                      option(value="" selected disabled) Select a category
                      each category in categories
                        option(value=category.id) #{category.icon} #{category.name}

              .sell-field
                label(for="description") Description
                textarea#description(
                  name="description"
                  rows="5"
                  placeholder="Describe your extraordinary collection..."
                  required
                )

              .sell-field
                label(for="imageUrl") Asset image URL
                input#imageUrl(
                    type="url"
                    name="imageUrl"
                    placeholder="https://example.com/your-trash-image.jpg"
                    maxlength="2048"
                )
                span.field-hint Paste a direct link to your asset image.

            .sell-section
              .section-heading
                span.section-number 02
                div
                  h2 Quantity & valuation
                  p Numbers that make absolutely no financial sense.

              .sell-grid
                .sell-field
                  label(for="quantity") Available quantity
                  input#quantity(
                    type="number"
                    name="quantity"
                    min="0.01"
                    step="0.01"
                    placeholder="e.g. 25"
                    required
                  )

                .sell-field
                  label(for="unit") Unit
                  select#unit(name="unit" required)
                    option(value="" selected disabled) Select unit
                    option(value="kg") Kilograms (kg)
                    option(value="pieces") Pieces
                    option(value="litres") Litres
                    option(value="boxes") Boxes

              .sell-field
                label(for="valuation") valuation (₹)
                input#valuation(
                  type="number"
                  name="valuation"
                  min="0"
                  step="0.01"
                  placeholder="e.g. 999999"
                  required
                )
                span.field-hint Your imaginary market valuation. Not an actual selling price.

            .sell-section
              .section-heading
                span.section-number 03
                div
                  h2 Location & discovery
                  p Every legendary asset has an origin story.

              .sell-field
                label(for="location") Location
                input#location(
                  type="text"
                  name="location"
                  placeholder="e.g. Bhopal, Madhya Pradesh"
                  maxlength="150"
                  required
                )

              .sell-field
                label(for="discoveryContext") Discovery story
                textarea#discoveryContext(
                  name="discoveryContext"
                  rows="3"
                  placeholder="Where did this legendary asset come from?"
                )

            .sell-submit-area
              p.sell-disclaimer
                | By publishing, you confirm this is a fictional marketplace listing.
                | No actual sale, payment or delivery will take place.

              button.sell-submit(type="submit") PUBLISH MY ASSET ↗

        aside.sell-sidebar
          .sell-tip-card
            span.tip-icon ✦
            span.tip-label THE SELLER'S PLAYBOOK
            h3 Think like a billionaire.
            p
              | A good listing needs a ridiculous title,
              | a convincing description and an origin story.

            .tip-divider

            .tip-item
              span ✓
              p Give your asset a memorable name.

            .tip-item
              span ✓
              p Describe its unique characteristics.

            .tip-item
              span ✓
              p Be honest about its quantity and location.

          .sell-sidebar-note
            span 🌍
            p
              | Listing trash here doesn't mean it has been cleaned up.
              | The real-world problem still exists.

