
extends ../layouts/base

block title
    title #{item.title} | TRASHBILLION

block stylesheet
    link(rel="stylesheet" href="/css/trash/details.css")

block content
    main.details-container

        a.back-link(href="/trash")
            span ←
            | BACK TO MARKETPLACE

        .details-layout

            // Main listing information
            section.details-main

                .details-category
                    if item.imageUrl
                        img.category-image(
                            src=item.imageUrl
                            alt=item.title
                        )
                    else
                        .category-image-placeholder 🗑️

                    span.category-name #{item.category}

                .details-heading
                    .listing-id LISTING ##{item.id}

                    h1= item.title

                    .listing-status
                        span.status-dot
                        | AVAILABLE

                .description-section
                    h2 THE STORY BEHIND THIS TRASH
                    p= item.description

                .specifications
                    h2 LISTING DETAILS

                    .specification-grid
                        .specification
                            span.spec-label CATEGORY
                            strong= item.category

                        .specification
                            span.spec-label AVAILABLE QUANTITY
                            strong #{item.quantity} #{item.unit}

                        .specification
                            span.spec-label LOCATION
                            strong= item.location

            // Portfolio panel
            aside.seller-card.portfolio-card

                .seller-card-top
                    span ✳
                    span INVESTMENT OPPORTUNITY

                h2 Found your next big asset?

                p
                    | Add this extraordinary piece of trash to your
                    | portfolio. Your financial advisor may need a moment.

                .portfolio-valuation
                    span.spec-label IMAGINARY VALUATION
                    strong= item.valuation

                form.portfolio-add-form(
                    action="/portfolio/add"
                    method="POST"
                )
                    input(
                        type="hidden"
                        name="listingId"
                        value=item.id
                    )

                    label(for="quantity") SELECT QUANTITY

                    .quantity-control
                        input#quantity(
                            type="number"
                            name="quantity"
                            min="1"
                            max=item.quantity
                            step="any"
                            value="1"
                            required
                        )

                        span= item.unit

                    button.add-portfolio-btn(type="submit")
                        | + ADD TO PORTFOLIO
                        span ↗

                p.portfolio-note
                    | NO MONEY INVOLVED. JUST QUESTIONABLE AMBITION.

                .seller-note
                    | Every piece of trash has a story.
                    | Unfortunately, not every story has a happy ending.
                    | Dispose responsibly.

        footer.details-footer
            p © 2026 TRASHBILLION. All trash reserved.
            a(href="/trash") EXPLORE MORE TRASH ↗
