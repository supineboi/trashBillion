
extends layouts/base

block title
    title TRASHBILLION — The World's Most Exclusive Garbage Market

block stylesheet
    link(rel="stylesheet" href="/css/index.css")

block content
    main.hero
        section
            .eyebrow
                span.dot
                    | THE WORLD'S MOST QUESTIONABLE MARKET

            h1
                | ONE MAN'S TRASH.
                br
                | ANOTHER MAN'S
                br
                span BILLION-DOLLAR ASSET.

            p.description
                | Welcome to the market where garbage gets a valuation,
                | sellers become CEOs, and buyers call themselves investors.
                | Because apparently, throwing things in a bin was too simple.

            .actions
                a.sell-button(href="/trash")
                    | EXPLORE THE MARKET
                    span ↗

                a.sell-button.secondary(href="/trash/sell")
                    | LIST YOUR TRASH
                    span ↗

            p.small-note No real money. No real deals. Questionable business decisions.

        section.visual
            .circle
                .trash-emoji 🗑️

            .floating-card.card-one
                .card-label YOUR TRASH VALUATION
                .card-value UNREASONABLY HIGH ↗

            .floating-card.card-two
                .card-label MARKET PHILOSOPHY
                .card-value Trash. But make it premium.

    .ticker
        .ticker-track
            span TRASH IS THE NEW GOLD
            | ✳
            span INVEST IN THE UNWANTED
            | ✳
            span FINANCIAL FREEDOM IS IN THE BIN
            | ✳
            span THE MARKET HAS LOST ITS MIND
            | ✳
            span TRASH IS THE NEW GOLD
            | ✳
            span INVEST IN THE UNWANTED
            | ✳
            span FINANCIAL FREEDOM IS IN THE BIN
            | ✳
            span THE MARKET HAS LOST ITS MIND
            | ✳

    footer.bottom
        p © 2026 TRASHBILLION. All trash reserved.
        p
            | A fictional marketplace. A very real-world problem.
