extends ../layouts/base

block title
    title TRASHBILLION — The World's Most Exclusive Garbage Market

block stylesheet
    link(rel="stylesheet" href="/css/user/auth.css")

block content
  .auth-page
    .auth-container

      .auth-card
        .auth-heading
          span.auth-eyebrow WELCOME BACK, INVESTOR
          h1 Your empire awaits.
          p Sign in to manage your questionable investments.

        form.auth-form(action="/user/login" method="POST")
          .form-group
            label(for="email") Email address
            input#email(
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            )

          .form-group
            .label-row
              label(for="password") Password
            input#password(
              type="password"
              name="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            )

          button.auth-submit(type="submit") SIGN IN TO YOUR EMPIRE

        .auth-divider
          span NEW TO THE TRASH ECONOMY?

        p.auth-switch
          | Don't have an account?
          a(href="/user/signup") Create one

      .auth-footer
        p No real wealth is created here. Probably.

